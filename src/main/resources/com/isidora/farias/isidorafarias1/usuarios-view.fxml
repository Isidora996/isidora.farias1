<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.isidora.farias.isidorafarias1.controller.UsuariosController">

    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>

    <Label text="Mantenedor de Usuarios" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtId" promptText="(automatico)" editable="false" disable="true"
                   maxWidth="80.0"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Nombre de usuario"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" promptText="correo@ejemplo.cl"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Contraseña:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtContrasena" promptText="Mínimo 4 caracteres"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button fx:id="btnAgregar" text="Agregar" onAction="#handleAgregarUsuario"
                defaultButton="true"/>
        <Button fx:id="btnModificar" text="Modificar" onAction="#handleModificarUsuario"
                disable="true"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminarUsuario"
                disable="true"/>
        <Button fx:id="btnLimpiar" text="Limpiar" onAction="#handleLimpiar"/>
    </HBox>

    <Separator/>
    
    <Label text="Usuarios registrados" style="-fx-font-weight: bold;"/>

    <TableView fx:id="tableUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150.0"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200.0"/>
            <TableColumn fx:id="colContrasena" text="Contraseña" prefWidth="120.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Todavía no hay usuarios. Agrega el primero."/>
        </placeholder>
    </TableView>

    <Label fx:id="lblEstado" text="Listo." style="-fx-text-fill: #666666;"/>

</VBox>